{
  "name": "coreline---engineering-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/auto_migrate.py && concurrently -n \"API,NEXT\" -c \"yellow,cyan\" \"uvicorn api.index:app --reload --port 8000\" \"next dev\"",
    "prebuild": "node scripts/validate-env.js",
    "build": "pip3 install -r api/requirements.txt --break-system-packages && python3 scripts/auto_migrate.py && next build",
    "start": "next start",
    "lint": "eslint .",
    "validate:env": "node scripts/validate-env.js",
    "db:migrate": "./scripts/db_sync.sh"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node-fetch": "^2.6.13",
    "autoprefixer": "^10.4.23",
    "date-fns": "^4.1.0",
    "material-symbols": "^0.40.2",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.3.8",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "^25.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  }
}